# loans-software/.env.example  (orquestación)
# Copia a .env. docker-compose lo lee automáticamente para interpolar ${VAR}.
# NO subas .env al repo.

NODE_ENV=development

# === JWT (MISMO valor para los 4 microservicios; obligatorio en producción) ===
# Genera uno fuerte: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRATION=24h
SALT_ROUNDS=12

# === Contraseñas de las bases de datos (cambiar en producción) ===
USER_SERVICE_DB_PASSWORD=password
LOAN_SERVICE_DB_PASSWORD=password
ADMIN_SERVICE_DB_PASSWORD=admin123
USER_LOGIN_DB_PASSWORD=password

# === CORS / Rate limiting (aplican a los servicios Nest) ===
CORS_ORIGINS=http://localhost:3004,http://localhost:3005
THROTTLE_TTL=60
THROTTLE_LIMIT=100
